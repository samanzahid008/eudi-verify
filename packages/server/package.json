{
  "name": "@eudi-verify/server",
  "version": "1.5.0",
  "description": "Framework-agnostic REST API handlers for EUDI Wallet verification",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync:version": "node ../../scripts/generate-package-versions.mjs server",
    "build": "node ../../scripts/generate-package-versions.mjs server && tsup src/index.ts --format esm --dts --clean",
    "typecheck": "node ../../scripts/generate-package-versions.mjs server && tsc --noEmit",
    "test": "node ../../scripts/generate-package-versions.mjs server && vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "eudi",
    "wallet",
    "verifier",
    "openid4vp",
    "eu-digital-identity",
    "eidas",
    "identity-verification"
  ],
  "author": "eudi-verify contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eudi-verify/eudi-verify.git",
    "directory": "packages/server"
  },
  "dependencies": {
    "@openeudi/core": "^0.8.0",
    "@openeudi/openid4vp": "^0.10.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "jose": "^6.2.8",
    "tsup": "^8.0.0"
  }
}
